# Server-only staging identity. Scope these values to the trusted staging branch
# in Vercel Preview, never Production. Obtain real values from reviewed accounts.
COREOPS_ENVIRONMENT=staging
COREOPS_STAGING_ENABLED=true
COREOPS_PAY1_PREVIEW_ENABLED=false
COREOPS_STAGING_ID=
COREOPS_STAGING_PROJECT_ID=
COREOPS_STAGING_BRANCH=
COREOPS_STAGING_DATABASE_HOST=
COREOPS_STAGING_DATABASE_NAME=
COREOPS_STAGING_CLERK_HOST=
# Stable branch alias, not the immutable per-deployment URL.
COREOPS_APP_ORIGIN=
COREOPS_MARKETING_ORIGIN=
COREOPS_ROUTING_MODE=path
COREOPS_PREVIEW_HOSTS=
COREOPS_PUBLIC_ONBOARDING_READY=true
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
PAYSTACK_TEST_SECRET_KEY=
PAYSTACK_TEST_MERCHANT_ID=
PAYSTACK_TEST_CURRENCY=KES
PAYSTACK_TEST_CHANNELS=
PAYSTACK_TEST_CHECKOUT_ENABLED=false
PAYSTACK_TEST_CAPABILITIES_APPROVAL=
PAYSTACK_TEST_SETTLEMENT_APPROVAL=
# Match actual Paystack webhook signing configuration. Retain signed raw body.
PAYSTACK_TEST_ALLOW_LEGACY_SIGNATURE=false
PAYSTACK_TEST_WEBHOOK_SECRET=
# No live secret belongs in this environment.
PAYSTACK_LIVE_CHECKOUT_ENABLED=false
COREOPS_MARKET_REHEARSAL_ENABLED=false
COREOPS_LEGAL_CATALOG_REHEARSAL_ENABLED=false
COREOPS_LIFECYCLE_ENFORCEMENT_ENABLED=false
COREOPS_LIFECYCLE_PROCESSING_ENABLED=false
COREOPS_SECURE_EXPORTS_ENABLED=false
COREOPS_NOTIFICATIONS_CAPTURE_ENABLED=false
COREOPS_NOTIFICATIONS_SEND_ENABLED=false
COREOPS_NOTIFICATIONS_SIMULATION_ENABLED=false
COREOPS_RESEND_ENGINEERING_ENABLED=false
# Genuine external operator job only; do not deploy its Vercel API token:
# COREOPS_STAGING_TEAM_ID=
# VERCEL_TOKEN=
# COREOPS_STAGING_MIGRATION_APPROVAL=
# COREOPS_STAGING_BACKUP_REFERENCE=
