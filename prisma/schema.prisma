// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  platformSuspended      Boolean                 @default(false)
  stagingAcknowledgments StagingAcknowledgment[]
  legalEvidenceSubject   LegalEvidenceSubject?
  marketApplications     MarketApplication[]
  marketSubmissions      MarketSubmission[]
  marketDecisions        MarketDecision[]
  notificationSources    NotificationSource[]
  notifications          NotificationOutbox[]
  id                     String                  @id @default(cuid())
  externalId             String?                 @unique
  name                   String?
  email                  String                  @unique
  imageUrl               String?

  platformAdmin        PlatformAdmin?
  subscriptionRequests SubscriptionRequest[]      @relation("RequestSubmitter")
  paymentSubmissions   SubscriptionPayment[]      @relation("PaymentSubmitter")
  legalAcceptances     LegalAcceptance[]
  memberships          WorkspaceMember[]
  auditLogs            AuditLog[]
  sentInvitations      WorkspaceInvitation[]
  exports              WorkspaceExportRequest[]
  recoveryRequests     WorkspaceRecoveryRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workspace {
  marketApplicationId  String?                   @unique
  marketApplication    MarketApplication?        @relation(fields: [marketApplicationId], references: [id], onDelete: Restrict)
  notificationSources  NotificationSource[]
  activationStatus     WorkspaceActivationStatus @default(PENDING_ACTIVATION)
  activatedAt          DateTime?
  subscriptionRequests SubscriptionRequest[]
  paymentSubmissions   SubscriptionPayment[]
  subscriptionPeriods  SubscriptionPeriod[]
  id                   String                    @id @default(cuid())
  name                 String
  slug                 String?                   @unique

  subscription     Subscription?
  auditLogs        AuditLog[]
  invitations      WorkspaceInvitation[]
  members          WorkspaceMember[]
  clients          Client[]
  projects         Project[]
  tasks            Task[]
  invoices         Invoice[]
  lifecycle        WorkspaceLifecycle?
  lifecycleEvents  WorkspaceLifecycleEvent[]
  exports          WorkspaceExportRequest[]
  recoveryRequests WorkspaceRecoveryRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkspaceMember {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  role               Role             @default(STAFF)
  status             MembershipStatus @default(ACTIVE)
  jobTitle           String?
  projectAssignments ProjectMember[]
  assignedTasks      Task[]           @relation("TaskAssignee")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, workspaceId])
  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@index([userId])
  @@index([workspaceId])
}

model Client {
  id      String       @id @default(cuid())
  name    String
  company String?
  email   String?
  phone   String?
  status  ClientStatus @default(ACTIVE)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  projects Project[]
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([workspaceId, status])
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  budget      Decimal?
  deadline    DateTime?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  tasks          Task[]
  projectMembers ProjectMember[]
  invoices       Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([clientId])
}

model Task {
  assignedMemberId String?
  assignee         WorkspaceMember? @relation("TaskAssignee", fields: [assignedMemberId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  teamVisible      Boolean          @default(false)
  id               String           @id @default(cuid())
  title            String
  description      String?
  status           TaskStatus       @default(TODO)
  priority         Priority         @default(MEDIUM)
  dueDate          DateTime?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, workspaceId])
  @@index([workspaceId, assignedMemberId])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, dueDate])
  @@index([projectId])
}

model Invoice {
  id        String        @id @default(cuid())
  invoiceNo String
  status    InvoiceStatus @default(DRAFT)
  amount    Decimal
  dueDate   DateTime?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  projectId String?
  project   Project? @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, dueDate])
  @@index([clientId])
  @@index([projectId])
}

enum ClientStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

model ProjectMember {
  id          String          @id @default(cuid())
  workspaceId String
  projectId   String
  project     Project         @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  memberId    String
  member      WorkspaceMember @relation(fields: [memberId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  createdAt   DateTime        @default(now())

  @@unique([projectId, memberId])
  @@index([workspaceId, memberId])
}

model AuditLog {
  notificationSources NotificationSource[]
  id                  String               @id @default(cuid())
  workspaceId         String
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actorUserId         String?
  actor               User?                @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action              String
  resourceType        String
  resourceId          String
  metadata            Json?
  createdAt           DateTime             @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, resourceType, resourceId])
}

model WorkspaceInvitation {
  id            String           @id @default(cuid())
  workspaceId   String
  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email         String
  role          Role             @default(STAFF)
  tokenHash     String           @unique
  status        InvitationStatus @default(PENDING)
  expiresAt     DateTime
  inviterUserId String
  inviter       User             @relation(fields: [inviterUserId], references: [id], onDelete: Restrict)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([workspaceId, email, status])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Subscription {
  id                     String                @id @default(cuid())
  workspaceId            String                @unique
  workspace              Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan                   SubscriptionPlan      @default(STARTER)
  status                 SubscriptionStatus    @default(PENDING_ACTIVATION)
  providerCustomerId     String?               @unique
  providerSubscriptionId String?               @unique
  currentPeriodEnd       DateTime?
  gracePeriodEnd         DateTime?
  requests               SubscriptionRequest[]
  periods                SubscriptionPeriod[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@unique([id, workspaceId])
}

enum SubscriptionPlan {
  SOLO
  STARTER
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  PENDING_ACTIVATION
  SUSPENDED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model LegalAcceptance {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  termsVersion         String
  privacyVersion       String
  termsUrl             String
  privacyUrl           String
  acceptedAt           DateTime  @default(now())
  source               String    @default("COREOPS_EXPLICIT")
  clerkLegalAcceptedAt DateTime?

  @@unique([userId, termsVersion, privacyVersion])
  @@index([userId, acceptedAt])
}

enum WorkspaceActivationStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  CLOSED
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum SubscriptionRequestType {
  INITIAL
  RENEWAL
  UPGRADE
}

enum CommercialRequestStatus {
  SUBMITTED
  QUOTED
  AWAITING_PAYMENT
  READY_FOR_ACTIVATION
  ACTIVATED
  REJECTED
  CANCELLED
}

enum ManualPaymentMethod {
  PAYSTACK
  MPESA
  BANK
}

enum PaymentSubmissionStatus {
  SUBMITTED
  RECONCILED
  REJECTED
}

enum TaxTreatment {
  NON_VAT_REGISTERED
  UNCONFIRMED
  INCLUSIVE
  EXCLUSIVE
  EXEMPT
}

enum PlatformRole {
  SUPER_ADMIN
  BILLING_ADMIN
  SUPPORT
}

model PlatformAdmin {
  legalVersions      LegalDocumentVersion[]
  legalReviews       LegalVersionReview[]
  legalPublications  LegalPublication[]
  legalEvents        LegalEvidenceEvent[]
  marketDecisions    MarketDecision[]
  noticeResolutions  LifecycleNotice[]
  recoveryReviews    WorkspaceRecoveryRequest[]
  id                 String                        @id @default(cuid())
  userId             String                        @unique
  user               User                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  role               PlatformRole
  active             Boolean                       @default(true)
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  auditEvents        PlatformAuditEvent[]
  reviewedRequests   SubscriptionRequest[]         @relation("RequestReviewer")
  overpaymentReviews SubscriptionRequest[]         @relation("OverpaymentReviewer")
  taxConfigurations  TaxConfiguration[]
  verifiedReceipts   SubscriptionPaymentReceipt[]
  reversals          SubscriptionPaymentReversal[]
  activatedPeriods   SubscriptionPeriod[]
  approvedOffers     SubscriptionPlanOffer[]
  verifiedAccounts   PaymentReceivingAccount[]
}

model PlatformAuditEvent {
  notificationReplacement NotificationOutbox? @relation("NotificationReplacementAudit")
  notificationSource      NotificationSource?
  id                      String              @id @default(cuid())
  actorAdminId            String
  actor                   PlatformAdmin       @relation(fields: [actorAdminId], references: [id], onDelete: Restrict)
  action                  String
  resourceType            String
  resourceId              String
  workspaceId             String?
  reason                  String
  metadata                Json?
  createdAt               DateTime            @default(now())

  @@index([workspaceId, createdAt])
  @@index([createdAt])
}

model SubscriptionPlanOffer {
  pricingRelease       String?
  commercialPath       String                @default("MANUAL")
  stagingEnvironmentId String?
  stagingEnvironment   StagingEnvironment?   @relation(fields: [stagingEnvironmentId], references: [id], onDelete: Restrict)
  id                   String                @id @default(cuid())
  plan                 SubscriptionPlan
  interval             BillingInterval
  version              Int
  name                 String
  amount               Decimal?              @db.Decimal(18, 2)
  currency             String                @default("KES")
  memberLimit          Int?
  projectLimit         Int?
  invitationsEnabled   Boolean               @default(false)
  features             Json
  taxTreatment         TaxTreatment          @default(UNCONFIRMED)
  published            Boolean               @default(false)
  businessApprovedAt   DateTime?
  businessApprovalRef  String?
  approvedById         String?
  approvedBy           PlatformAdmin?        @relation(fields: [approvedById], references: [id], onDelete: Restrict)
  requests             SubscriptionRequest[]
  createdAt            DateTime              @default(now())

  @@unique([plan, interval, version])
}

model PaymentReceivingAccount {
  id                String                @id @default(cuid())
  label             String
  method            ManualPaymentMethod
  currency          String                @default("KES")
  accountIdentifier String
  instructions      String
  active            Boolean               @default(false)
  verifiedAt        DateTime?
  verifiedById      String?
  verifiedBy        PlatformAdmin?        @relation(fields: [verifiedById], references: [id], onDelete: Restrict)
  requests          SubscriptionRequest[]
  submissions       SubscriptionPayment[]
  createdAt         DateTime              @default(now())

  @@unique([method, accountIdentifier])
  @@unique([id, method, currency])
}

model SubscriptionRequest {
  commercialPath          String                   @default("MANUAL")
  stagingEnvironmentId    String?
  stagingEnvironment      StagingEnvironment?      @relation(fields: [stagingEnvironmentId], references: [id], onDelete: Restrict)
  notificationSources     NotificationSource[]
  id                      String                   @id @default(cuid())
  workspaceId             String
  workspace               Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  subscriptionId          String
  subscription            Subscription             @relation(fields: [subscriptionId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  submittedByUserId       String
  submittedBy             User                     @relation("RequestSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  offerId                 String
  offer                   SubscriptionPlanOffer    @relation(fields: [offerId], references: [id], onDelete: Restrict)
  type                    SubscriptionRequestType
  status                  CommercialRequestStatus  @default(SUBMITTED)
  idempotencyKey          String
  payloadHash             String
  plan                    SubscriptionPlan
  interval                BillingInterval
  offerVersion            Int
  catalogAmount           Decimal?                 @db.Decimal(18, 2)
  quotedAmount            Decimal?                 @db.Decimal(18, 2)
  taxAmount               Decimal?                 @db.Decimal(18, 2)
  payableAmount           Decimal?                 @db.Decimal(18, 2)
  currency                String
  memberLimit             Int?
  projectLimit            Int?
  invitationsEnabled      Boolean
  features                Json
  taxTreatment            TaxTreatment
  approvedAt              DateTime?
  reviewedById            String?
  reviewedBy              PlatformAdmin?           @relation("RequestReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewNotes             String?
  quoteAcceptedAt         DateTime?
  receivingAccountId      String?
  receivingAccount        PaymentReceivingAccount? @relation(fields: [receivingAccountId], references: [id], onDelete: Restrict)
  paymentInstructions     Json?
  overpaymentReviewedAt   DateTime?
  overpaymentReviewedById String?
  overpaymentReviewedBy   PlatformAdmin?           @relation("OverpaymentReviewer", fields: [overpaymentReviewedById], references: [id], onDelete: Restrict)
  overpaymentDisposition  String?
  netAmount               Decimal?                 @db.Decimal(18, 2)
  vatRate                 Decimal?                 @db.Decimal(7, 4)
  taxSnapshot             Json?
  payments                SubscriptionPayment[]
  period                  SubscriptionPeriod?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@unique([workspaceId, idempotencyKey])
  @@unique([id, workspaceId])
  @@unique([id, workspaceId, subscriptionId])
  @@unique([id, workspaceId, receivingAccountId, currency])
  @@index([status, createdAt])
}

model SubscriptionPayment {
  notificationSources NotificationSource[]
  id                  String                      @id @default(cuid())
  workspaceId         String
  workspace           Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  requestId           String
  request             SubscriptionRequest         @relation(fields: [requestId, workspaceId, receivingAccountId, currency], references: [id, workspaceId, receivingAccountId, currency], onDelete: Restrict)
  receivingAccountId  String
  method              ManualPaymentMethod
  currency            String
  receivingAccount    PaymentReceivingAccount     @relation(fields: [receivingAccountId, method, currency], references: [id, method, currency], onDelete: Restrict)
  submittedByUserId   String
  submittedBy         User                        @relation("PaymentSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  proposedAmount      Decimal                     @db.Decimal(18, 2)
  submittedReference  String
  normalizedReference String
  idempotencyKey      String
  payloadHash         String
  status              PaymentSubmissionStatus     @default(SUBMITTED)
  reviewNotes         String?
  providerAttempt     PaystackAttempt?
  receipt             SubscriptionPaymentReceipt?
  createdAt           DateTime                    @default(now())

  @@unique([requestId, idempotencyKey])
  @@unique([id, workspaceId, requestId, receivingAccountId, method, currency])
  @@index([status, createdAt])
}

model SubscriptionPaymentReceipt {
  activatedPeriod      SubscriptionPeriod?          @relation("PeriodReceipt")
  notificationSources  NotificationSource[]
  id                   String                       @id @default(cuid())
  submissionId         String                       @unique
  workspaceId          String
  requestId            String
  receivingAccountId   String
  method               ManualPaymentMethod
  currency             String
  submission           SubscriptionPayment          @relation(fields: [submissionId, workspaceId, requestId, receivingAccountId, method, currency], references: [id, workspaceId, requestId, receivingAccountId, method, currency], onDelete: Restrict)
  amount               Decimal                      @db.Decimal(18, 2)
  transactionReference String
  ledgerEntryId        String
  receivedAt           DateTime
  verifiedAt           DateTime                     @default(now())
  verifiedById         String?
  verifiedBy           PlatformAdmin?               @relation(fields: [verifiedById], references: [id], onDelete: Restrict)
  confirmationSource   PaymentConfirmationSource    @default(MANUAL)
  taxSnapshot          Json?
  providerAttemptId    String?                      @unique
  providerAttempt      PaystackAttempt?             @relation(fields: [providerAttemptId, submissionId, workspaceId, requestId, receivingAccountId, method, currency], references: [id, paymentId, workspaceId, requestId, receivingAccountId, method, currency], onDelete: Restrict)
  verificationNotes    String
  reversal             SubscriptionPaymentReversal?

  @@unique([providerAttemptId, submissionId, workspaceId, requestId, receivingAccountId, method, currency])
  @@unique([submissionId, workspaceId, requestId, receivingAccountId, method, currency])
  @@unique([receivingAccountId, method, transactionReference])
  @@unique([receivingAccountId, ledgerEntryId])
  @@index([workspaceId, requestId])
}

model SubscriptionPaymentReversal {
  notificationSources NotificationSource[]
  id                  String                     @id @default(cuid())
  receiptId           String                     @unique
  receipt             SubscriptionPaymentReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  actorAdminId        String
  actor               PlatformAdmin              @relation(fields: [actorAdminId], references: [id], onDelete: Restrict)
  reason              String
  reversedAt          DateTime                   @default(now())
}

model SubscriptionPeriod {
  activationSource    String                      @default("ADMIN")
  verifiedReceiptId   String?                     @unique
  verifiedReceipt     SubscriptionPaymentReceipt? @relation("PeriodReceipt", fields: [verifiedReceiptId], references: [id], onDelete: Restrict)
  notificationSources NotificationSource[]
  exports             WorkspaceExportRequest[]
  recoveryEpisodes    WorkspaceRecoveryRequest[]  @relation("RecoveryEpisode")
  recoveryActivations WorkspaceRecoveryRequest[]  @relation("RecoveryActivation")
  id                  String                      @id @default(cuid())
  workspaceId         String
  workspace           Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  subscriptionId      String
  subscription        Subscription                @relation(fields: [subscriptionId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  sourceRequestId     String                      @unique
  sourceRequest       SubscriptionRequest         @relation(fields: [sourceRequestId, workspaceId, subscriptionId], references: [id, workspaceId, subscriptionId], onDelete: Restrict)
  plan                SubscriptionPlan
  interval            BillingInterval
  startsAt            DateTime
  endsAt              DateTime
  graceEndsAt         DateTime
  anchorDay           Int
  memberLimit         Int
  projectLimit        Int?
  invitationsEnabled  Boolean
  features            Json
  agreedAmount        Decimal                     @db.Decimal(18, 2)
  currency            String
  activatedById       String?
  activatedBy         PlatformAdmin?              @relation(fields: [activatedById], references: [id], onDelete: Restrict)
  revokedAt           DateTime?
  createdAt           DateTime                    @default(now())
  lifecycle           WorkspaceLifecycle?
  lifecycleEvents     WorkspaceLifecycleEvent[]

  @@unique([id, workspaceId])
  @@unique([sourceRequestId, workspaceId, subscriptionId])
  @@index([workspaceId, startsAt, endsAt])
}

// Checkpoint B: non-destructive lifecycle journal. No deletion capabilities.
model WorkspaceLifecycle {
  workspaceId             String             @id
  workspace               Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  sourcePeriodId          String             @unique
  sourcePeriod            SubscriptionPeriod @relation(fields: [sourcePeriodId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  episodeId               String             @unique
  policyVersion           String
  revision                Int                @default(1)
  archivedAt              DateTime?
  cancellationEffectiveAt DateTime?
  cancellationRecordedAt  DateTime?
  retentionEndsAt         DateTime?
  nextEvaluationAt        DateTime?
  updatedAt               DateTime           @updatedAt

  @@unique([sourcePeriodId, workspaceId])
  @@index([nextEvaluationAt])
  @@index([retentionEndsAt])
}

enum WorkspaceLifecycleEventType {
  WORKSPACE_ARCHIVED
  WORKSPACE_CANCELED
  WORKSPACE_REACTIVATED
  EXPORT_REQUESTED
  EXPORT_READY
  EXPORT_FAILED
  EXPORT_EXPIRED
  EXPORT_DOWNLOAD_AUTHORIZED
  RECOVERY_REQUESTED
  RECOVERY_APPROVED
  RECOVERY_REJECTED
  RECOVERY_REVOKED
  RECOVERY_GRANT_EXPIRED
  WORKSPACE_RESTORED
}

model WorkspaceLifecycleEvent {
  notificationSource NotificationSource?
  exportId           String?
  export             WorkspaceExportRequest?     @relation(fields: [exportId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  recoveryId         String?
  recovery           WorkspaceRecoveryRequest?   @relation(fields: [recoveryId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  id                 String                      @id @default(cuid())
  workspaceId        String
  workspace          Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  episodeId          String
  episode            SubscriptionPeriod          @relation(fields: [episodeId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  type               WorkspaceLifecycleEventType
  effectiveAt        DateTime
  recordedAt         DateTime                    @default(now())
  policyVersion      String
  operationKey       String                      @unique

  @@index([workspaceId, recordedAt])
  @@index([recordedAt, id])
}

enum WorkspaceExportStatus {
  REQUESTED
  PROCESSING
  READY
  FAILED
  DOWNLOADED
  EXPIRED
}

enum WorkspaceRecoveryStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
  EXPIRED
}

model WorkspaceExportRequest {
  availabilityVersion Int                           @default(1)
  generatedAt         DateTime?
  artifactExpiresAt   DateTime?
  artifactKeyVersion  String?
  requesterExternalId String?
  requesterEmailHash  String?
  downloadLeaseToken  String?
  authorizations      ExportDownloadAuthorization[]
  id                  String                        @id @default(cuid())
  workspaceId         String
  workspace           Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  requesterId         String
  requester           User                          @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  sourcePeriodId      String
  sourcePeriod        SubscriptionPeriod            @relation(fields: [sourcePeriodId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  recoveryId          String?
  recovery            WorkspaceRecoveryRequest?     @relation(fields: [recoveryId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  idempotencyKey      String
  payloadHash         String
  status              WorkspaceExportStatus         @default(REQUESTED)
  schemaVersion       String                        @default("workspace-export-v1")
  expiresAt           DateTime
  leaseUntil          DateTime?
  artifact            Bytes?
  artifactDigest      String?
  tokenHash           String?
  errorCode           String?
  events              WorkspaceLifecycleEvent[]
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  @@unique([requesterId, idempotencyKey])
  @@unique([id, workspaceId])
  @@index([workspaceId, status, expiresAt])
  @@index([expiresAt])
}

model WorkspaceRecoveryRequest {
  id                  String                    @id @default(cuid())
  workspaceId         String
  workspace           Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  requesterId         String
  requester           User                      @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  requesterExternalId String
  emailHash           String
  sourcePeriodId      String
  sourcePeriod        SubscriptionPeriod        @relation("RecoveryEpisode", fields: [sourcePeriodId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  idempotencyKey      String
  payloadHash         String
  claimReference      String
  status              WorkspaceRecoveryStatus   @default(PENDING)
  reviewedById        String?
  reviewedBy          PlatformAdmin?            @relation(fields: [reviewedById], references: [id], onDelete: Restrict)
  evidenceReferences  String?
  reviewReason        String?
  identityCheckedAt   DateTime?
  ownershipVerifiedAt DateTime?
  reviewedAt          DateTime?
  expiresAt           DateTime?
  allowExport         Boolean                   @default(false)
  allowReactivation   Boolean                   @default(false)
  revokedAt           DateTime?
  revocationReason    String?
  activationPeriodId  String?                   @unique
  activationPeriod    SubscriptionPeriod?       @relation("RecoveryActivation", fields: [activationPeriodId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  activatedAt         DateTime?
  exports             WorkspaceExportRequest[]
  events              WorkspaceLifecycleEvent[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@unique([requesterId, idempotencyKey])
  @@unique([id, workspaceId])
  @@unique([activationPeriodId, workspaceId])
  @@index([workspaceId, status])
  @@index([expiresAt])
}

model LifecycleJobRun {
  id          String    @id @default(cuid())
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  processed   Int       @default(0)
  skipped     Int       @default(0)
  failed      Int       @default(0)
  failureCode String?
  cursor      String?
  outcomes    Json      @default("[]")
}

enum VatRegistrationStatus {
  UNVERIFIED
  NOT_REGISTERED
  REGISTERED
  DEREGISTERED
}

enum PaymentConfirmationSource {
  MANUAL
  PAYSTACK
}

enum PaystackMode {
  test
  live
}

enum PaystackAttemptStatus {
  FAILED
  ABANDONED
  CREATED
  INITIALIZED
  CONFIRMED
  REVIEW
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  REVIEW
}

model TaxConfiguration {
  synthetic             Boolean               @default(false)
  id                    String                @id @default(cuid())
  version               Int                   @unique
  registrationStatus    VatRegistrationStatus
  registrationReference String?
  effectiveFrom         DateTime              @unique
  rate                  Decimal               @db.Decimal(7, 4)
  allowedTreatments     Json
  approvalReference     String
  approvedById          String
  approvedBy            PlatformAdmin         @relation(fields: [approvedById], references: [id], onDelete: Restrict)
  createdAt             DateTime              @default(now())
}

model PaystackAttempt {
  id                    String                      @id @default(cuid())
  paymentId             String                      @unique
  workspaceId           String
  requestId             String
  receivingAccountId    String
  method                ManualPaymentMethod         @default(PAYSTACK)
  currency              String
  payment               SubscriptionPayment         @relation(fields: [paymentId, workspaceId, requestId, receivingAccountId, method, currency], references: [id, workspaceId, requestId, receivingAccountId, method, currency], onDelete: Restrict)
  mode                  PaystackMode
  reference             String                      @unique
  idempotencyKey        String
  merchantId            String
  keyFingerprint        String
  expectedMinor         BigInt
  providerTransactionId String?
  status                PaystackAttemptStatus       @default(CREATED)
  authorizationUrl      String?
  lastError             String?
  receipt               SubscriptionPaymentReceipt?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  @@unique([workspaceId, idempotencyKey])
  @@unique([paymentId, workspaceId, requestId, receivingAccountId, method, currency])
  @@unique([mode, merchantId, providerTransactionId])
  @@unique([id, paymentId, workspaceId, requestId, receivingAccountId, method, currency])
  @@index([status, createdAt])
}

model PaystackWebhookEvent {
  id          String             @id @default(cuid())
  mode        PaystackMode
  eventHash   String
  reference   String?
  eventType   String
  status      PaymentEventStatus @default(RECEIVED)
  failureCode String?
  createdAt   DateTime           @default(now())
  processedAt DateTime?

  @@unique([mode, eventHash])
  @@index([status, createdAt])
}

// N-B capture-only foundation; no email provider or live sending.
enum NotificationScope {
  TENANT
  ACCOUNT
  PLATFORM
}

enum NotificationSourceState {
  PENDING
  WAITING_FOR_TRANSITION
  WAITING_FOR_RECIPIENT
  RESOLVED
  AUDIT_ONLY
  HISTORICAL_REVIEW
  REVIEW_REQUIRED
}

enum NotificationProcessingState {
  PENDING
  CLAIMED
  RETRY_PENDING
  SETTLED
  SUPPRESSED
  CANCELED
  MANUAL_REVIEW
}

enum NotificationDeliveryOutcome {
  NOT_SENT
  UNKNOWN
  PROVIDER_ACCEPTED
  DELIVERED_TO_SERVER
  DELAYED
  BOUNCED
  COMPLAINED
  FAILED
}

enum NotificationAttemptResult {
  CAPTURE_INTENT
  CAPTURE_ABANDONED
  CAPTURED
  DISPATCH_INTENT
  ACCEPTED
  KNOWN_REJECTED
  RATE_LIMITED
  UNKNOWN
}

enum NotificationProviderEventState {
  VERIFIED_PENDING
  APPLIED
  QUARANTINED
}

enum LifecycleNoticeState {
  OPEN
  SATISFIED_UNDER_POLICY
  REVIEW_REQUIRED
  RESOLVED_BY_REVIEW
}

model NotificationSource {
  id                 String                       @id @default(cuid())
  canonicalKey       String                       @unique
  scope              NotificationScope
  kind               String
  workspaceId        String?
  workspace          Workspace?                   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  subjectUserId      String?
  subjectUser        User?                        @relation(fields: [subjectUserId], references: [id], onDelete: Restrict)
  lifecycleEventId   String?                      @unique
  lifecycleEvent     WorkspaceLifecycleEvent?     @relation(fields: [lifecycleEventId], references: [id], onDelete: Restrict)
  requestId          String?
  request            SubscriptionRequest?         @relation(fields: [requestId], references: [id], onDelete: Restrict)
  paymentId          String?
  payment            SubscriptionPayment?         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  receiptId          String?
  receipt            SubscriptionPaymentReceipt?  @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  reversalId         String?
  reversal           SubscriptionPaymentReversal? @relation(fields: [reversalId], references: [id], onDelete: Restrict)
  periodId           String?
  period             SubscriptionPeriod?          @relation(fields: [periodId], references: [id], onDelete: Restrict)
  auditLogId         String?
  auditLog           AuditLog?                    @relation(fields: [auditLogId], references: [id], onDelete: Restrict)
  platformAuditId    String?                      @unique
  platformAudit      PlatformAuditEvent?          @relation(fields: [platformAuditId], references: [id], onDelete: Restrict)
  milestone          String?
  accountOperationId String?                      @unique
  incidentKey        String?
  effectiveAt        DateTime
  recordedAt         DateTime                     @default(now())
  scheduledAt        DateTime?
  latestSendAt       DateTime?
  policyVersion      String
  state              NotificationSourceState      @default(PENDING)
  nextReconcileAt    DateTime?
  leaseToken         String?
  leaseUntil         DateTime?
  dispositionCode    String?
  notice             LifecycleNotice?
  notifications      NotificationOutbox[]

  @@index([workspaceId, effectiveAt])
  @@index([subjectUserId, effectiveAt])
  @@index([state, nextReconcileAt, id])
}

model LifecycleNotice {
  id                     String               @id @default(cuid())
  sourceId               String               @unique
  source                 NotificationSource   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  obligationKey          String               @unique
  milestone              String
  dueAt                  DateTime
  minimumLeadDeadlineAt  DateTime?
  recipientPolicyVersion String
  evidencePolicyVersion  String
  required               Boolean
  state                  LifecycleNoticeState @default(OPEN)
  resolvedByAdminId      String?
  resolvedBy             PlatformAdmin?       @relation(fields: [resolvedByAdminId], references: [id], onDelete: Restrict)
  resolvedAt             DateTime?
  resolutionReason       String?
  evidenceReference      String?
  notifications          NotificationOutbox[]
  createdAt              DateTime             @default(now())

  @@index([state, dueAt])
}

model NotificationOutbox {
  engineeringTransport   String?
  identityKeyVersion     String?
  simulated              Boolean                       @default(false)
  replacementAuditId     String?                       @unique
  replacementAudit       PlatformAuditEvent?           @relation("NotificationReplacementAudit", fields: [replacementAuditId], references: [id], onDelete: Restrict)
  permits                NotificationProviderPermit[]
  id                     String                        @id @default(cuid())
  sourceId               String
  source                 NotificationSource            @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  noticeId               String?
  notice                 LifecycleNotice?              @relation(fields: [noticeId], references: [id], onDelete: Restrict)
  recipientUserId        String
  recipientUser          User                          @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)
  kind                   String
  channel                String                        @default("EMAIL")
  templateVersion        String
  templateDigest         String
  recipientPolicyVersion String
  logicalKey             String
  generation             Int                           @default(1)
  replacesId             String?
  replaces               NotificationOutbox?           @relation("NotificationReplacement", fields: [replacesId], references: [id], onDelete: Restrict)
  replacements           NotificationOutbox[]          @relation("NotificationReplacement")
  scheduledAt            DateTime
  latestSendAt           DateTime?
  priority               Int
  processingState        NotificationProcessingState   @default(PENDING)
  deliveryOutcome        NotificationDeliveryOutcome   @default(NOT_SENT)
  leaseToken             String?
  leaseUntil             DateTime?
  version                Int                           @default(1)
  dispatchedAttempts     Int                           @default(0)
  nextAttemptAt          DateTime?
  firstDispatchedAt      DateTime?
  safeRetryUntil         DateTime?
  providerScope          String
  providerKey            String                        @unique
  providerMessageId      String?
  captureAttempts        Int                           @default(0)
  captureId              String?                       @unique
  frozenPayloadCipher    Bytes?
  payloadKeyVersion      String?
  payloadHash            String?
  destinationDigest      String?
  identityBindingDigest  String?
  recipientVerifiedAt    DateTime?
  acceptedAt             DateTime?
  deliveredAt            DateTime?
  bouncedAt              DateTime?
  complainedAt           DateTime?
  lastFailureCode        String?
  completedAt            DateTime?
  createdAt              DateTime                      @default(now())
  attempts               NotificationDeliveryAttempt[]
  providerEvents         NotificationProviderEvent[]

  @@unique([logicalKey, generation])
  @@unique([providerScope, providerMessageId])
  @@unique([id, providerScope])
  @@unique([id, providerScope, providerKey, payloadHash])
  @@index([processingState, nextAttemptAt, scheduledAt, priority, id])
  @@index([sourceId, recipientUserId])
  @@index([recipientUserId, createdAt])
}

model NotificationDeliveryAttempt {
  mode              String                      @default("CAPTURE")
  captureId         String?
  id                String                      @id @default(cuid())
  notificationId    String
  providerScope     String
  providerKey       String
  payloadHash       String
  notification      NotificationOutbox          @relation(fields: [notificationId, providerScope, providerKey, payloadHash], references: [id, providerScope, providerKey, payloadHash], onDelete: Restrict, onUpdate: Restrict)
  runId             String?
  run               NotificationRun?            @relation(fields: [runId], references: [id], onDelete: Restrict)
  attemptNo         Int
  leaseToken        String
  startedAt         DateTime                    @default(now())
  dispatchedAt      DateTime?
  completedAt       DateTime?
  result            NotificationAttemptResult   @default(CAPTURE_INTENT)
  responseCategory  String?
  providerMessageId String?
  retryEligible     Boolean                     @default(false)
  providerEvents    NotificationProviderEvent[]

  @@unique([notificationId, attemptNo])
  @@unique([id, notificationId])
  @@index([providerScope, providerMessageId])
  @@index([result, dispatchedAt])
}

model NotificationProviderEvent {
  evidenceProtocol        String                         @default("SYNTHETIC")
  candidateNotificationId String?
  candidateAttemptId      String?
  simulated               Boolean                        @default(false)
  id                      String                         @id @default(cuid())
  providerScope           String
  providerEventId         String
  providerMessageId       String?
  notificationId          String?
  notification            NotificationOutbox?            @relation(fields: [notificationId, providerScope], references: [id, providerScope], onDelete: Restrict)
  attemptId               String?
  attempt                 NotificationDeliveryAttempt?   @relation(fields: [attemptId, notificationId], references: [id, notificationId], onDelete: Restrict)
  eventType               String
  occurredAt              DateTime?
  receivedAt              DateTime                       @default(now())
  verifiedAt              DateTime
  verificationKeyRef      String
  bodyDigest              String
  destinationDigest       String?
  state                   NotificationProviderEventState @default(VERIFIED_PENDING)
  failureCode             String?
  processedAt             DateTime?
  evidenceCipher          Bytes?
  evidenceKeyVersion      String?
  evidenceExpiresAt       DateTime?
  suppressions            NotificationSuppression[]

  @@unique([providerScope, providerEventId])
  @@index([providerScope, providerMessageId])
  @@index([state, receivedAt])
  @@index([evidenceExpiresAt])
}

model NotificationRun {
  simulated      Boolean                       @default(false)
  id             String                        @id @default(cuid())
  dryRun         Boolean
  startedAt      DateTime                      @default(now())
  completedAt    DateTime?
  leaseToken     String
  eligibleCount  Int                           @default(0)
  processedCount Int                           @default(0)
  retryCount     Int                           @default(0)
  failedCount    Int                           @default(0)
  skippedCount   Int                           @default(0)
  failureCode    String?
  summary        Json?
  attempts       NotificationDeliveryAttempt[]

  @@index([startedAt])
  @@index([completedAt])
}

model NotificationSuppression {
  id                String                     @id @default(cuid())
  providerScope     String
  channel           String                     @default("EMAIL")
  destinationDigest String
  digestKeyVersion  String
  reasonCode        String
  providerEventId   String?
  providerEvent     NotificationProviderEvent? @relation(fields: [providerEventId], references: [id], onDelete: Restrict)
  active            Boolean                    @default(true)
  createdAt         DateTime                   @default(now())
  reviewAt          DateTime?
  releasedAt        DateTime?
  releaseReason     String?

  @@unique([providerScope, channel, digestKeyVersion, destinationDigest])
  @@index([active, reviewAt])
}

model NotificationControl {
  simulationLaneCursor Int       @default(0)
  simulationEnabled    Boolean   @default(false)
  key                  String    @id
  enabled              Boolean   @default(false)
  captureEnabled       Boolean   @default(false)
  discoveryCursor      Int       @default(0)
  configRevision       Int       @default(1)
  policyVersion        String
  settings             Json
  pauseUntil           DateTime?
  nextPermitAt         DateTime?
  workerLeaseToken     String?
  workerLeaseUntil     DateTime?
  updatedAt            DateTime  @updatedAt
}

// Isolated N-C simulation; no production transport or restore admission.
model NotificationProviderPermit {
  slot           Int                 @id
  token          String?             @unique
  notificationId String?
  notification   NotificationOutbox? @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  leaseUntil     DateTime?
}

model NotificationSimulationInstance {
  scope     String?
  id        String   @id
  createdAt DateTime @default(now())
}

model ExportDownloadAuthorization {
  id          String                 @id @default(cuid())
  exportId    String
  workspaceId String
  export      WorkspaceExportRequest @relation(fields: [exportId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Restrict)
  requesterId String
  tokenHash   String                 @unique
  issuedAt    DateTime               @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?
  revokedAt   DateTime?

  @@index([requesterId, issuedAt])
  @@index([exportId, expiresAt])
}

// Market foundation: no historical customer classification or retention schedule.
enum MarketAvailability {
  OPEN
  REVIEW_REQUIRED
  UNAVAILABLE
}

enum MarketApplicationState {
  SUBMITTED
  APPROVED
  DEFERRED
  REJECTED
  REVOKED
  WITHDRAWN
}

enum MarketDecisionType {
  OPEN_POLICY
  APPROVE
  DEFER
  REJECT
  REVOKE
  WITHDRAW
}

model MarketPolicy {
  id                  String             @id
  revision            Int                @unique
  defaultAvailability MarketAvailability @default(REVIEW_REQUIRED)
  countries           Json
  createdAt           DateTime           @default(now())
  submissions         MarketSubmission[]
}

model MarketApplication {
  pay1AdmissionId       String?
  pay1Admission         Pay1PreviewAdmission?  @relation(fields: [pay1AdmissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  latestSubmission      MarketSubmission?      @relation("MarketLatest", fields: [latestSubmissionId, id], references: [id, applicationId], onDelete: NoAction, onUpdate: NoAction, map: "market_latest_fk")
  operativeSubmission   MarketSubmission?      @relation("MarketOperative", fields: [operativeSubmissionId, id], references: [id, applicationId], onDelete: NoAction, onUpdate: NoAction, map: "market_operative_fk")
  currentDecision       MarketDecision?        @relation("MarketCurrent", fields: [currentDecisionId, id], references: [id, applicationId], onDelete: NoAction, onUpdate: NoAction, map: "market_decision_fk")
  id                    String                 @id @default(cuid())
  applicantUserId       String
  applicant             User                   @relation(fields: [applicantUserId], references: [id], onDelete: Restrict)
  latestSubmissionId    String?
  operativeSubmissionId String?
  currentDecisionId     String?
  state                 MarketApplicationState @default(SUBMITTED)
  revision              Int                    @default(0)
  createdAt             DateTime               @default(now())
  workspace             Workspace?
  submissions           MarketSubmission[]
  decisions             MarketDecision[]

  @@index([applicantUserId, createdAt])
  @@index([state, createdAt])
  @@index([pay1AdmissionId, createdAt])
}

model MarketSubmission {
  latestFor         MarketApplication[] @relation("MarketLatest")
  operativeFor      MarketApplication[] @relation("MarketOperative")
  declarationSource String              @default("SELF_DECLARED")
  id                String              @id @default(cuid())
  applicationId     String
  application       MarketApplication   @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  applicantUserId   String
  applicant         User                @relation(fields: [applicantUserId], references: [id], onDelete: Restrict)
  revision          Int
  policyId          String
  policy            MarketPolicy        @relation(fields: [policyId], references: [id], onDelete: Restrict)
  country           String
  interest          String
  useCase           String
  attestedAt        DateTime            @default(now())
  idempotencyKey    String
  payloadHash       String
  decisions         MarketDecision[]

  @@unique([applicationId, revision])
  @@unique([applicantUserId, idempotencyKey])
  @@unique([id, applicationId])
}

model MarketDecision {
  currentFor          MarketApplication[] @relation("MarketCurrent")
  applicationRevision Int?
  id                  String              @id @default(cuid())
  applicationId       String
  application         MarketApplication   @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  submissionId        String
  submission          MarketSubmission    @relation(fields: [submissionId, applicationId], references: [id, applicationId], onDelete: Restrict)
  type                MarketDecisionType
  actorUserId         String
  actor               User                @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  reviewerAdminId     String?
  reviewer            PlatformAdmin?      @relation(fields: [reviewerAdminId], references: [id], onDelete: Restrict)
  reason              String
  effectiveAt         DateTime            @default(now())
  validUntil          DateTime?
  recordedAt          DateTime            @default(now())
  operationKey        String              @unique
  payloadHash         String

  @@unique([id, applicationId])
}

// P-C2C synthetic legal-evidence rehearsal only. No real legal approval.
enum LegalDocumentKind {
  TERMS
  PRIVACY
  CUSTOMER_DPA
  COOKIE_NOTICE
  RETENTION_SCHEDULE
}

enum LegalReviewAction {
  SIMULATED_APPROVE
  WITHDRAW
}

enum LegalEvidenceEventType {
  PUBLISHED
  SUPERSEDED
  WITHDRAWN
  TERMS_AGREED_PRIVACY_ACKNOWLEDGED
  SUBJECT_DETACHED
}

model LegalDocumentVersion {
  id              String               @id @default(cuid())
  kind            LegalDocumentKind
  version         String
  language        String
  format          String               @default("TEXT_UTF8")
  rendererVersion String               @default("PLAIN_UTF8-v1")
  content         Bytes
  contentHash     String
  hashAlgorithm   String               @default("SHA-256")
  byteLength      Int
  synthetic       Boolean              @default(true)
  createdAt       DateTime             @default(now())
  createdById     String
  createdBy       PlatformAdmin        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  reviews         LegalVersionReview[]
  termsSets       LegalPublication[]   @relation("LegalTerms")
  privacySets     LegalPublication[]   @relation("LegalPrivacy")

  @@unique([kind, version, language])
}

model LegalVersionReview {
  id                String               @id @default(cuid())
  versionId         String
  version           LegalDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  action            LegalReviewAction
  reviewerId        String
  reviewer          PlatformAdmin        @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  evidenceReference String
  reason            String
  recordedAt        DateTime             @default(now())
  termsSets         LegalPublication[]   @relation("LegalTermsReview")
  privacySets       LegalPublication[]   @relation("LegalPrivacyReview")

  @@unique([versionId, action])
}

model LegalPublication {
  id              String                    @id
  version         String                    @unique
  termsId         String
  terms           LegalDocumentVersion      @relation("LegalTerms", fields: [termsId], references: [id], onDelete: Restrict)
  privacyId       String
  privacy         LegalDocumentVersion      @relation("LegalPrivacy", fields: [privacyId], references: [id], onDelete: Restrict)
  termsReviewId   String
  termsReview     LegalVersionReview        @relation("LegalTermsReview", fields: [termsReviewId], references: [id], onDelete: Restrict)
  privacyReviewId String
  privacyReview   LegalVersionReview        @relation("LegalPrivacyReview", fields: [privacyReviewId], references: [id], onDelete: Restrict)
  manifest        Bytes
  manifestHash    String
  publishedAt     DateTime
  effectiveAt     DateTime
  publisherId     String
  publisher       PlatformAdmin             @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  synthetic       Boolean                   @default(true)
  presentations   LegalPresentation[]
  receipts        LegalAcceptanceEvidence[]
  controls        LegalPublicationControl[]
  events          LegalEvidenceEvent[]
}

model LegalPublicationControl {
  id            String            @id
  publicationId String?
  publication   LegalPublication? @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  revision      Int               @default(0)
}

model LegalEvidenceSubject {
  id                       String                    @id @default(cuid())
  userId                   String?                   @unique
  user                     User?                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt                DateTime                  @default(now())
  detachedAt               DateTime?
  retentionReviewReference String?
  presentations            LegalPresentation[]
  receipts                 LegalAcceptanceEvidence[]
  events                   LegalEvidenceEvent[]
}

model LegalPresentation {
  id              String                    @id @default(cuid())
  publicationId   String
  publication     LegalPublication          @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  subjectId       String
  subject         LegalEvidenceSubject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  controlRevision Int
  presentedAt     DateTime                  @default(now())
  expiresAt       DateTime
  receipts        LegalAcceptanceEvidence[]

  @@unique([id, publicationId, subjectId])
}

model LegalAcceptanceEvidence {
  id                    String               @id @default(cuid())
  subjectId             String
  subject               LegalEvidenceSubject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  publicationId         String
  publication           LegalPublication     @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  presentationId        String
  presentation          LegalPresentation    @relation(fields: [presentationId, publicationId, subjectId], references: [id, publicationId, subjectId], onDelete: Restrict)
  termsAgreement        Boolean
  privacyAcknowledgment Boolean
  source                String               @default("REHEARSAL_AUTHENTICATED_EXPLICIT")
  acceptedAt            DateTime             @default(now())
  synthetic             Boolean              @default(true)
  events                LegalEvidenceEvent[]

  @@unique([subjectId, publicationId])
}

model LegalEvidenceEvent {
  id            String                   @id @default(cuid())
  type          LegalEvidenceEventType
  publicationId String?
  publication   LegalPublication?        @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  subjectId     String?
  subject       LegalEvidenceSubject?    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  receiptId     String?
  receipt       LegalAcceptanceEvidence? @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  actorAdminId  String?
  actor         PlatformAdmin?           @relation(fields: [actorAdminId], references: [id], onDelete: Restrict)
  operationKey  String                   @unique
  recordedAt    DateTime                 @default(now())
  synthetic     Boolean                  @default(true)
}

// Empty by default: a separately reviewed operator record is required for PAY-1.
model Pay1PreviewAdmission {
  id                String              @id
  projectId         String
  deploymentId      String
  origin            String
  databaseHost      String
  databaseName      String
  clerkHost         String
  actorExternalIds  String[]
  approvalReference String
  syntheticOnly     Boolean             @default(true)
  notBefore         DateTime
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime            @default(now())
  applications      MarketApplication[]
}

// Persistent synthetic environment identity, independent of individual deployments.
model StagingEnvironment {
  id                String                  @id
  projectId         String
  origin            String
  databaseHost      String
  databaseName      String
  clerkHost         String
  syntheticOnly     Boolean                 @default(true)
  active            Boolean                 @default(true)
  approvalReference String
  createdAt         DateTime                @default(now())
  offers            SubscriptionPlanOffer[]
  requests          SubscriptionRequest[]
  acknowledgments   StagingAcknowledgment[]
}

model StagingAcknowledgment {
  id                   String             @id @default(cuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  stagingEnvironmentId String
  environment          StagingEnvironment @relation(fields: [stagingEnvironmentId], references: [id], onDelete: Restrict)
  content              String
  contentHash          String
  acceptedAt           DateTime           @default(now())

  @@unique([userId, stagingEnvironmentId, contentHash], map: "StagingAcknowledgment_userId_stagingEnvironmentId_contentHash_k")
}
