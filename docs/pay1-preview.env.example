# TEMPLATE ONLY. Do not copy credentials into Git or reports.
# VERCEL, VERCEL_ENV, VERCEL_PROJECT_ID and VERCEL_DEPLOYMENT_ID must be genuine
# deployment runtime metadata. Do not spoof these locally to obtain admission.
COREOPS_PAY1_PREVIEW_ENABLED=false
COREOPS_PAY1_ADMISSION_ID=REPLACE_AFTER_REVIEW
COREOPS_ENVIRONMENT=preview
COREOPS_ROUTING_MODE=path
COREOPS_APP_ORIGIN=https://REPLACE-EXACT-PREVIEW-HOST
COREOPS_MARKETING_ORIGIN=https://REPLACE-EXACT-PREVIEW-HOST
COREOPS_PREVIEW_HOSTS=REPLACE-EXACT-PREVIEW-HOST
# DATABASE_URL: existing preview target, TLS; never provision/rename a DB.
# Clerk: isolated development instance, pk_test_ and server-only sk_test_ keys.
# Keys belong in protected provider configuration, never this template.
COREOPS_MARKET_REHEARSAL_ENABLED=false
COREOPS_LEGAL_CATALOG_REHEARSAL_ENABLED=false
COREOPS_LIFECYCLE_ENFORCEMENT_ENABLED=false
COREOPS_LIFECYCLE_PROCESSING_ENABLED=false
COREOPS_SECURE_EXPORTS_ENABLED=false
COREOPS_NOTIFICATIONS_CAPTURE_ENABLED=false
COREOPS_NOTIFICATIONS_SIMULATION_ENABLED=false
COREOPS_RESEND_ENGINEERING_ENABLED=false
COREOPS_NOTIFICATIONS_SEND_ENABLED=false
PAYSTACK_LIVE_CHECKOUT_ENABLED=false
# PAYSTACK_LIVE_SECRET_KEY must be absent.
PAYSTACK_TEST_CHECKOUT_ENABLED=false
PAYSTACK_TEST_CURRENCY=KES
# PAYSTACK_TEST_SECRET_KEY: sk_test_... (server-only)
# PAYSTACK_TEST_MERCHANT_ID, PAYSTACK_TEST_CHANNELS: actual verified Test account.
# PAYSTACK_TEST_CAPABILITIES_APPROVAL / PAYSTACK_TEST_SETTLEMENT_APPROVAL:
# actual test-account review references, not a claim of live settlement acceptance.
# PAYSTACK_TEST_WEBHOOK_SECRET: actual Test mode whsec_... (server-only).
PAYSTACK_TEST_ALLOW_LEGACY_SIGNATURE=false
# Actual mode signing setup must be inspected before enabling legacy explicitly.
# Callback: https://EXACT-PREVIEW-HOST/payments/paystack/return
# Webhook: https://EXACT-PREVIEW-HOST/api/payments/paystack/test/webhook
# Existing registration/legal/Clerk readiness is NOT overridden by PAY-1.
