# Documentation only. Set separately in the appropriate environment's secret store.
# Do not copy localhost identities or fixtures into preview/production.
COREOPS_ENVIRONMENT=preview
# Same exact central origin as routing; replace with the approved preview URL.
COREOPS_APP_ORIGIN=https://preview.example.invalid
COREOPS_MARKETING_ORIGIN=https://preview.example.invalid
COREOPS_PUBLIC_URL=https://preview.example.invalid
# Also configure COREOPS_PREVIEW_HOSTS for the real Vercel Preview hostname.
# DATABASE_URL: pooled preview-only application connection
# DIRECT_URL: direct preview-only migration connection (never production in preview)

PAYSTACK_TEST_CHECKOUT_ENABLED=false
PAYSTACK_TEST_SECRET_KEY=
PAYSTACK_TEST_WEBHOOK_SECRET=
PAYSTACK_TEST_MERCHANT_ID=
PAYSTACK_TEST_CURRENCY=KES
PAYSTACK_TEST_CHANNELS=
PAYSTACK_TEST_CAPABILITIES_APPROVAL=
PAYSTACK_TEST_SETTLEMENT_APPROVAL=
PAYSTACK_TEST_ALLOW_LEGACY_SIGNATURE=false

# Supply live credentials ONLY in production after an approved live-readiness review.
PAYSTACK_LIVE_CHECKOUT_ENABLED=false
PAYSTACK_LIVE_SECRET_KEY=
PAYSTACK_LIVE_WEBHOOK_SECRET=
PAYSTACK_LIVE_MERCHANT_ID=
PAYSTACK_LIVE_CURRENCY=KES
PAYSTACK_LIVE_CHANNELS=
PAYSTACK_LIVE_CAPABILITIES_APPROVAL=
PAYSTACK_LIVE_SETTLEMENT_APPROVAL=
PAYSTACK_LIVE_ALLOW_LEGACY_SIGNATURE=false
# No Paystack plan codes, reusable authorizations, recurring subscriptions or automatic charges.
# VAT is database-versioned through /platform/tax; no environment rate can enable it.
