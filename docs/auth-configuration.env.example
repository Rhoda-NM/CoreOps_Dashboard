# Provisional values supplied by Stravect Systems. These do not mean approval.
COREOPS_TERMS_URL=https://coreops.studio/terms
COREOPS_PRIVACY_URL=https://coreops.studio/privacy
COREOPS_TERMS_VERSION=COREOPS-TOS-v1.0
COREOPS_PRIVACY_VERSION=COREOPS-PRIV-v1.0
COREOPS_SUPPORT_EMAIL=info@stravectsystems.com
COREOPS_LEGAL_DOCUMENTS_APPROVED=false
# Leave blank until final approval. Use an ISO timestamp with timezone.
COREOPS_TERMS_EFFECTIVE_AT=
COREOPS_PRIVACY_EFFECTIVE_AT=
# Set only after reviewing the actual Google request and provider configuration.
COREOPS_GOOGLE_IDENTITY_SCOPES_REVIEWED=false
# No mandatory consent for provisional documents in development.
COREOPS_REQUIRE_LEGAL_ACCEPTANCE=false
# Production registration is fail-closed regardless of the development switch.
# Existing Clerk secret/publishable keys remain in the deployment secret manager.

# Optional SDK diagnostics opt-out; this is not a security/audit-log switch.
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=true
