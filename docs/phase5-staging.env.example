# REFERENCE ONLY. No keys, DB credentials, consent approvals or live payments.
# Fill these through Vercel's Preview secret/config scopes after project linking.
# Replace this exact hostname with the deployment being tested; no wildcards.
COREOPS_ROUTING_MODE=path
COREOPS_APP_ORIGIN=https://REPLACE-EXACT-PREVIEW.vercel.app
COREOPS_MARKETING_ORIGIN=https://REPLACE-EXACT-PREVIEW.vercel.app
COREOPS_PREVIEW_HOSTS=REPLACE-EXACT-PREVIEW.vercel.app
COREOPS_ENVIRONMENT=preview
COREOPS_PUBLIC_INDEXING_ENABLED=false
COREOPS_PUBLIC_ONBOARDING_READY=false
PAYSTACK_TEST_CHECKOUT_ENABLED=false
PAYSTACK_LIVE_CHECKOUT_ENABLED=false
COREOPS_LEGAL_DOCUMENTS_APPROVED=false
COREOPS_GOOGLE_IDENTITY_SCOPES_REVIEWED=false

# Isolated HTTPS subdomain test project, separately reviewed AFTER path preview.
# Candidate namespace only; no DNS/Clerk changes have been approved or made here.
# It must NOT run with VERCEL_ENV=preview, which intentionally forbids subdomains.
# COREOPS_ROUTING_MODE=subdomain
# COREOPS_APP_ORIGIN=https://app.staging.workflowconnect.io
# COREOPS_MARKETING_ORIGIN=https://staging.workflowconnect.io
# COREOPS_TENANT_ROOT_DOMAIN=staging.workflowconnect.io
# COREOPS_CANONICAL_URL=https://staging.workflowconnect.io
# COREOPS_ENVIRONMENT=staging
# COREOPS_PREVIEW_HOSTS=
# COREOPS_PUBLIC_URL, if retained from earlier payment config, must exactly
# identify the central app origin, never the marketing or tenant origin.
# Keys, webhook secrets and DATABASE_URL/DIRECT_URL are deliberately omitted.
